# 开发环境（SQLite，零配置）
DATABASE_URL="file:./dev.db"

# 正式上线（Postgres，docker-compose 已内置）改用：
# DATABASE_URL="postgresql://banju:CHANGE_ME_PG_PASSWORD@postgres:5432/banju"

# 这几个用户名注册后自动成为管理员（逗号分隔，多个）
ADMIN_USERNAMES="banju-admin"

# 本地与局域网 http 环境保持 false；上了 HTTPS 改 true
COOKIE_SECURE=false

# 测试账号统一密码（seed 用，上线后立即改掉）
SEED_PASSWORD="banju-test-2026"
